# Reference: docs/PLAN.md (§4 Phase 1) and docs/DECISIONS.md (D-003).

# ─────────────────────────────────────────────────────────────
# Linux kernel (latest LTS branch on kernel.org)
# ─────────────────────────────────────────────────────────────
KERNEL_MAJOR="6"
KERNEL_VERSION="6.18.63"
KERNEL_TARBALL="linux-${KERNEL_VERSION}.tar.xz"
KERNEL_SIGN="linux-${KERNEL_VERSION}.tar.sign"
KERNEL_URL="https://cdn.kernel.org/pub/linux/kernel/v${KERNEL_MAJOR}.x/${KERNEL_TARBALL}"
KERNEL_SIGN_URL="https://cdn.kernel.org/pub/linux/kernel/v${KERNEL_MAJOR}.x/${KERNEL_SIGN}"
KERNEL_SHA256="81764a545072d160748beff4d9de2e7d95aa9f16e8261110288f067a2cc61d71"

# Pinned OpenPGP primary-key fingerprints allowed to sign the kernel .tar archive:
#   Linus Torvalds     <torvalds@kernel.org>
#   Greg Kroah-Hartman <gregkh@kernel.org>
KERNEL_PGP_FPR_TORVALDS="ABAF11C65A2970B130ABE3C479BE3E4300411886"
KERNEL_PGP_FPR_GREGKH="647F28654894E3BD457199BE38DBBDC86092693E"
KERNEL_PGP_FINGERPRINTS="${KERNEL_PGP_FPR_TORVALDS} ${KERNEL_PGP_FPR_GREGKH}"
KERNEL_PGP_WKD_IDS="torvalds@kernel.org gregkh@kernel.org"

# ─────────────────────────────────────────────────────────────
