# SPDX-License-Identifier: GPL-2.0-only
#
# ShardKey BusyBox configuration fragment (applied on top of 'make allnoconfig').
# Enables only the static shell and system applets required by /init and
# /lib/shardkey/prep-drive.sh, with all networking and dynamic-code features off.
#
# Reference: docs/PLAN.md (§4 Phase 3) and docs/DECISIONS.md (D-001, D-004, D-013, D-019).

# ─────────────────────────────────────────────────────────────
# Build & General Settings
# ─────────────────────────────────────────────────────────────
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_BUSYBOX=y
# CONFIG_PIE is not set
# CONFIG_BUILD_LIBBUSYBOX is not set
# CONFIG_FEATURE_INSTALLER is not set
# CONFIG_FEATURE_SHOW_SCRIPT is not set
# CONFIG_FEATURE_SUID is not set

# ─────────────────────────────────────────────────────────────
# Shell: ash (as sh) + standalone applet execution
# ─────────────────────────────────────────────────────────────
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
# CONFIG_SH_IS_HUSH is not set
# CONFIG_SH_IS_NONE is not set
# CONFIG_BASH_IS_ASH is not set
# CONFIG_BASH_IS_HUSH is not set
CONFIG_BASH_IS_NONE=y
CONFIG_SHELL_ASH=y
# CONFIG_HUSH is not set
# CONFIG_SHELL_HUSH is not set
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_FEATURE_TEST_64=y
CONFIG_ASH_SLEEP=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_FEATURE_SH_EXTRA_QUIET=y

# ─────────────────────────────────────────────────────────────
# Required Applets (docs/PLAN.md §4 Phase 3)
#   ash (as sh), mount, umount, mkdir, cat, echo, sleep, dd,
#   fdisk, mkfs.vfat, sync, poweroff, blockdev, stty, clear, ls
# ─────────────────────────────────────────────────────────────
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
# CONFIG_FEATURE_MOUNT_NFS is not set
# CONFIG_FEATURE_MOUNT_CIFS is not set
# CONFIG_FEATURE_MOUNT_HELPERS is not set
# CONFIG_FEATURE_MOUNT_LABEL is not set
# CONFIG_FEATURE_MOUNT_FSTAB is not set

CONFIG_UMOUNT=y
CONFIG_FEATURE_UMOUNT_ALL=y

CONFIG_MKDIR=y

CONFIG_CAT=y

CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y

CONFIG_SLEEP=y
CONFIG_FEATURE_FANCY_SLEEP=y

CONFIG_DD=y
CONFIG_FEATURE_DD_IBS_OBS=y
CONFIG_FEATURE_DD_STATUS=y

CONFIG_FDISK=y
CONFIG_FEATURE_FDISK_WRITABLE=y
CONFIG_FEATURE_FDISK_ADVANCED=y
# CONFIG_FEATURE_AIX_LABEL is not set
# CONFIG_FEATURE_SGI_LABEL is not set
# CONFIG_FEATURE_SUN_LABEL is not set
# CONFIG_FEATURE_OSF_LABEL is not set
# CONFIG_FEATURE_GPT_LABEL is not set

CONFIG_MKFS_VFAT=y
# CONFIG_MKDOSFS is not set

CONFIG_SYNC=y
CONFIG_FEATURE_SYNC_FANCY=y
# CONFIG_FSYNC is not set

CONFIG_POWEROFF=y
# CONFIG_HALT is not set
# CONFIG_REBOOT is not set
# CONFIG_FEATURE_WAIT_FOR_INIT is not set
# CONFIG_FEATURE_CALL_TELINIT is not set

CONFIG_BLOCKDEV=y

CONFIG_STTY=y

CONFIG_CLEAR=y

CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_FOLLOWLINKS=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_WIDTH=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_USERNAME=y

# ─────────────────────────────────────────────────────────────
# Explicitly Forbidden Subsystems & Applets
# ─────────────────────────────────────────────────────────────
# CONFIG_MDEV is not set
# CONFIG_FEATURE_IPV6 is not set
# CONFIG_FEATURE_UNIX_LOCAL is not set
# CONFIG_ARP is not set
# CONFIG_ARPING is not set
# CONFIG_BRCTL is not set
# CONFIG_DNSD is not set
# CONFIG_ETHER_WAKE is not set
# CONFIG_FTPD is not set
# CONFIG_FTPGET is not set
# CONFIG_FTPPUT is not set
# CONFIG_HOSTNAME is not set
# CONFIG_DNSDOMAINNAME is not set
# CONFIG_HTTPD is not set
# CONFIG_IFCONFIG is not set
# CONFIG_IFENSLAVE is not set
# CONFIG_IFPLUGD is not set
# CONFIG_IFUP is not set
# CONFIG_IFDOWN is not set
# CONFIG_INETD is not set
# CONFIG_IP is not set
# CONFIG_IPADDR is not set
# CONFIG_IPLINK is not set
# CONFIG_IPROUTE is not set
# CONFIG_IPTUNNEL is not set
# CONFIG_IPRULE is not set
# CONFIG_IPNEIGH is not set
# CONFIG_IPCALC is not set
# CONFIG_FAKEIDENTD is not set
# CONFIG_NAMEIF is not set
# CONFIG_NBDCLIENT is not set
# CONFIG_NC is not set
# CONFIG_NETCAT is not set
# CONFIG_NETSTAT is not set
# CONFIG_NSLOOKUP is not set
# CONFIG_NTPD is not set
# CONFIG_PING is not set
# CONFIG_PING6 is not set
# CONFIG_PSCAN is not set
# CONFIG_ROUTE is not set
# CONFIG_SLATTACH is not set
# CONFIG_SSL_CLIENT is not set
# CONFIG_TC is not set
# CONFIG_TCPSVD is not set
# CONFIG_UDPSVD is not set
# CONFIG_TELNET is not set
# CONFIG_TELNETD is not set
# CONFIG_TFTP is not set
# CONFIG_TFTPD is not set
# CONFIG_TRACEROUTE is not set
# CONFIG_TRACEROUTE6 is not set
# CONFIG_TUNCTL is not set
# CONFIG_VCONFIG is not set
# CONFIG_WGET is not set
# CONFIG_WHOIS is not set
# CONFIG_ZCIP is not set
# CONFIG_UDHCPD is not set
# CONFIG_DUMPLEASES is not set
# CONFIG_DHCPRELAY is not set
# CONFIG_UDHCPC is not set
# CONFIG_UDHCPC6 is not set
