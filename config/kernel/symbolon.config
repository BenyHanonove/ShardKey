# SPDX-License-Identifier: GPL-2.0-only
#
# Symbolon Linux kernel configuration fragment (x86_64, linux-6.18.63).
# Applied on top of 'make allnoconfig' via KCONFIG_ALLCONFIG.
# scripts/build-kernel.sh substitutes __INITRAMFS_SOURCE__ with the generated
# build/initramfs.list path in the resolved temporary fragment before configuring.
#
# Reference: docs/KERNEL_CONFIG.md and docs/DECISIONS.md (D-001..D-015).

# ─────────────────────────────────────────────────────────────
# Architecture and explicit forbidden-symbol overrides
# ─────────────────────────────────────────────────────────────
CONFIG_64BIT=y
# EXPERT is needed solely to expose and disable default-y options (COREDUMP, IO_URING)
CONFIG_EXPERT=y
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_SWAP is not set
# CONFIG_COREDUMP is not set
# CONFIG_IO_URING is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_EFIVAR_FS is not set

# ─────────────────────────────────────────────────────────────
# Built-in kernel command line (bootloader args ignored)
# ─────────────────────────────────────────────────────────────
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE_OVERRIDE=y
CONFIG_CMDLINE="console=tty0 loglevel=3 init_on_alloc=1 init_on_free=1 page_alloc.shuffle=1 efi=noruntime panic=0"

# ─────────────────────────────────────────────────────────────
# Core kernel & initramfs
# ─────────────────────────────────────────────────────────────
CONFIG_PRINTK=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FUTEX=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="__INITRAMFS_SOURCE__"
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# ─────────────────────────────────────────────────────────────
# Boot (UEFI EFI stub + KASLR, and legacy BIOS)
# ─────────────────────────────────────────────────────────────
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y

# ─────────────────────────────────────────────────────────────
# Console and keyboard (VGA BIOS, EFI framebuffer, PS/2 & USB HID)
# ─────────────────────────────────────────────────────────────
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y

CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y

CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# ─────────────────────────────────────────────────────────────
# USB host controllers and flash storage (internal disks omitted)
# ─────────────────────────────────────────────────────────────
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_MSDOS_PARTITION=y

# ─────────────────────────────────────────────────────────────
# Filesystems (FAT32 / VFAT only)
# ─────────────────────────────────────────────────────────────
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ─────────────────────────────────────────────────────────────
# Hardening
# ─────────────────────────────────────────────────────────────
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_PANIC_ON_OOPS=y
