# SPDX-License-Identifier: GPL-2.0-only
#
# QEMU serial debug overlay (never used for real ceremony images).
# Appended after config/kernel/symbolon.config when building with --debug.
#
# Reference: docs/KERNEL_CONFIG.md (§5).

CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_CMDLINE="console=tty0 console=ttyS0 loglevel=3 init_on_alloc=1 init_on_free=1 page_alloc.shuffle=1 efi=noruntime panic=0"
